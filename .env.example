DATABASE_URL=
DATABASE_URL_UNPOOLED=
TMDB_READ_ACCESS_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set to 1 to capture magic-link tokens in memory for local development
# instead of sending mail. Must not be set in production.
MAGIC_LINK_SINK=
CRON_SECRET=
LOOKUP_DEADLINE_MS=8000
STALE_AFTER_HOURS=12
CONFIDENCE_FLOOR=0.75
JOB_MAX_ATTEMPTS=6

# --- theporndb.net, for the xxx category -----------------------------------
# Missing this is not an outage: an xxx lookup answers `unresolved` and the
# other categories are unaffected.
TPDB_API_KEY=

# --- OAuth on preview deployments ------------------------------------------
# A preview cannot register its own OAuth callback: its hostname changes every
# deployment, and GitHub's wildcard matching is over subdomains of a host you
# control, which *.vercel.app is not. So the provider always redirects to
# production, which hands the handshake onward to the preview that began it.
#
# None of these are needed for a single-environment deployment. All three are
# needed for previews, and the scoping is what makes them work:
#
#   BETTER_AUTH_URL              production only. Left unset on a preview so
#                                the deployment infers its own origin from
#                                VERCEL_URL. Set at project scope it silently
#                                sends every preview's handshake to production.
#   BETTER_AUTH_PRODUCTION_URL   preview only. Where the provider redirects.
#                                Unset on production, where the plugin's own
#                                default (BETTER_AUTH_URL) is already right.
#   BETTER_AUTH_PROXY_SECRET     both, same value. Encrypts the payload passed
#                                between the two deployments. Deliberately not
#                                BETTER_AUTH_SECRET, which differs per
#                                environment so a leak from a preview cannot
#                                forge a production session.
#   BETTER_AUTH_TRUSTED_ORIGINS  both. Read by Better Auth itself, not by this
#                                codebase. Production refuses to redirect into
#                                an untrusted origin, so without it the
#                                handshake reaches GitHub and is refused 403 on
#                                the way home. Scope it to the project AND the
#                                team; a bare https://*.vercel.app would trust
#                                every deployment on the platform.
BETTER_AUTH_PRODUCTION_URL=
BETTER_AUTH_PROXY_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=https://<vercel-project>-*-<team-slug>.vercel.app
